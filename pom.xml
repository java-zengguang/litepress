<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.java-zengguang</groupId>
    <artifactId>litepress</artifactId>
    <packaging>pom</packaging>
    <version>${revision}</version>


    <modules>
        <module>litepress-core</module>
        <module>litepress-web</module>
        <module>litepress-direction</module>
        <module>litepress-cache</module>
        <module>litepress-network</module>
        <module>litepress-chain</module>
        <module>litepress-event</module>
        <module>litepress-task</module>
        <module>litepress-router</module>
        <module>litepress-reaction</module>
        <module>litepress-ml</module>
        <module>litepress-db</module>
        <module>litepress-boot</module>
    </modules>


    <properties>
        <slf4j.api>2.0.13</slf4j.api>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <revision>0.0.1</revision>
    </properties>


